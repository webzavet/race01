{
  "type": "module",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.20.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "bundle:spec": "swagger-cli bundle docs/api.yaml -o docs/api-bundled.yaml --type yaml",
    "gen:resources": "npm run bundle:spec && rm -rf resources/* && openapi-generator-cli generate -i docs/api-bundled.yaml -g javascript -o resources --skip-validate-spec --additional-properties=usePromises=true",
    "gen:all": "npm run gen:resources"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.14.1",
    "path": "^0.12.7",
    "process": "^0.11.10",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  }
}
